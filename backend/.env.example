# AuditOS AI Backend configuration.
#
# Copy to backend/.env and fill in the key. backend/.env is gitignored and must
# never be committed — it is the only place the Gemini credential exists.

# Required. Obtain from Google AI Studio (https://aistudio.google.com/apikey).
# Put the real key in backend/.env — NEVER in this file. This one is a
# committed template; anything written here is published with the repository.
GEMINI_API_KEY=

# The model the narrative agent drafts with. Kept in configuration rather than
# code because Gemini model identifiers rotate; copy the exact string from AI
# Studio. Must be a standard generateContent model — the *-live-* models use
# the bidirectional streaming Live API, which this service does not speak.
GEMINI_MODEL=gemini-3.1-flash-lite

# Origins permitted to call this service. The prototype is served either from
# file:// (Origin: null) or from a local static server.
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,null
